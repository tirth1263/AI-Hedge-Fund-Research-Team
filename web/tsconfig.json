{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@services/*": ["../services/*"]
    }
  },
  "include": [
    "src",
    "../services/types.ts",
    "../services/nebius-ai",
    "../services/utils/helper-functions.ts",
    "../services/utils/WebSearchService.ts"
  ]
}
